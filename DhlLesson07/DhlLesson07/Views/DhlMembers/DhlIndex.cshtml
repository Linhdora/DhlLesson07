@model IEnumerable<DhlLesson07.Models.DhlMember>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="DhlCreate">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.DhlUserName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DhlPassword)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DhlEmail)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DhlPhone)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.DhlUserName)
            </td>
            <td>
                @Html.DisplayFor(model => item.DhlPassword)
            </td>
            <td>
                @Html.DisplayFor(model => item.DhlEmail)
            </td>
            <td>
                @Html.DisplayFor(model => item.DhlPhone)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
